# /etc/vidmar/publish.env – readable by root and vidmar-build only (chmod 640)
# the admin's secret path, the same as ADMIN_URL's last part in ~/.vidmar-admin
VIDMAR_ADMIN_PATH=
BRANCH=main
WEB_ROOT=/var/www/vidmar
# SRC_DIR=/srv/vidmar-build
# STATE_DIR=/var/lib/vidmar-publish
# REPO_URL=https://github.com/eprisj/vidmar.git
